# Fonts

# BEGIN_KITTY_FONTS

font_family      family="IosevkaTerm Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto

# END_KITTY_FONTS

# Shell

shell_integration enabled

# Hyperlinks

allow_hyperlinks yes

# Cursor

cursor_shape underline
cursor_underline_thickness 2.0
cursor_trail 1
cursor_trail_decay 0.1 0.4

# Window

window_padding_width 18
enabled_layouts grid

# Keybinds

## Window navigation

map cmd+alt+left  neighboring_window left
map cmd+alt+right neighboring_window right
map cmd+alt+up    neighboring_window up
map cmd+alt+down  neighboring_window down

## Window management

map cmd+shift+enter new_window
map cmd+shift+w close_window

## Tabs

map cmd+shift+t new_tab
map cmd+shift+left previous_tab
map cmd+shift+right next_tab

## Move current window

map cmd+shift+alt+left  move_window left
map cmd+shift+alt+right move_window right
map cmd+shift+alt+up    move_window up
map cmd+shift+alt+down  move_window down

# Tabs

tab_bar_edge top
tab_bar_style powerline
tab_powerline_style slanted
tab_bar_min_tabs 1

## Tab titles

tab_title_template " {title} "
active_tab_title_template " {title} "
